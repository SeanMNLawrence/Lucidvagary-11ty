---
layout: layouts/base.njk
title: "lucid vagary"
---
<div class="home-grid">
  <h1 class="visually-hidden">Lucid Vagary artwork and writing</h1>

  {% set hero = collections.featuredPost | first %}

  {# LEFT: recent posts feed, hero already excluded in the collection itself #}
  <aside class="home-recent">
    <h2 class="visually-hidden">Recent posts</h2>
    {% for post in collections.recentPosts %}
    <a href="{{ post.url }}" class="recent-card" aria-label="Read {{ post.data.title }}">
      {% if post.data.image %}
      <div class="recent-image">
        {% optimizedImage post.data.image, "", "thumbnail", "lazy" %}
      </div>

      {% endif %}
      {% if post.data.tags %}
      <div class="post-tags-mini">
        {% for tag in post.data.tags %}
        <span class="post-tag-mini">{{ tag }}</span>
        {% endfor %}
      </div>
      {% endif %}
      <h3>{{ post.data.title }}</h3>
      <p><time class="post-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time></p>
    </a>
    {% endfor %}
  </aside>

  {# CENTER: the single assigned/featured post - nothing else lives here #}
  <section class="home-hero">
    <h2 class="visually-hidden">Featured post</h2>
    {% if hero.data.image %}
    <a href="{{ hero.url }}" class="hero-featured-image" aria-label="Read {{ hero.data.title }}">
      {% optimizedImage hero.data.image, "", "artwork", "eager" %}
    </a>
    {% endif %}
    {% if hero.data.tags %}
    <div class="post-tags-mini">
      {% for tag in hero.data.tags %}
      <span class="post-tag-mini">{{ tag }}</span>
      {% endfor %}
    </div>
    {% endif %}
    <h3><a href="{{ hero.url }}">{{ hero.data.title }}</a></h3>
    {% if hero.data.description %}
    <p class="hero-featured-excerpt">{{ hero.data.description }}</p>
    {% endif %}
  </section>

  {# RIGHT: one highlight per tag, never repeating the hero or each other #}
  <aside class="home-bytag">
    <h2 class="visually-hidden">Highlights by tag</h2>
    {% for item in collections.highlightsByTag | batch(4) | first %}
    <a href="{{ item.post.url }}" class="bytag-card" aria-label="Read {{ item.post.data.title }}">
      {% if item.post.data.image %}
      <div class="bytag-image">
        {% optimizedImage item.post.data.image, "", "thumbnail", "lazy" %}
      </div>
      {% endif %}
      <div class="bytag-body">
        <span class="post-tag-mini">{{ item.tag }}</span>
        <p class="bytag-excerpt">{{ item.post.data.description or item.post.data.title }}</p>
      </div>
    </a>
    {% endfor %}
    <a href="/archive/" class="bytag-archive-link">Browse the archive &rarr;</a>
  </aside>

</div>

<section class="home-sketchbook posts-section" aria-labelledby="home-sketchbook-title">
  <div class="home-sketchbook-heading">
    <div>
      <h2 class="posts-title" id="home-sketchbook-title">From the sketchbook</h2>
      <p class="posts-intro">Watercolor and drawing studies from the sketchbook.</p>
    </div>
    <a class="home-sketchbook-link" href="/sketchbook/">View all sketchbook pages &rarr;</a>
  </div>
  <div class="home-sketchbook-grid">
    <a href="/sketchbook/#water-and-trees" aria-label="View Water and trees sketchbook page">
      {% optimizedImage "/images/sketchbook-riverside.jpg", "Watercolor sketch of trees along a river or lake, with loose green washes across the water.", "card", "lazy" %}
      <span>Water and trees</span>
    </a>
    <a href="/sketchbook/#building-study" aria-label="View Building study sketchbook page">
      {% optimizedImage "/images/sketchbook-building.jpg", "Loose pen and watercolor sketch of a building facade, storefronts, and architectural details.", "card", "lazy" %}
      <span>Building study</span>
    </a>
    <a href="/sketchbook/#still-life" aria-label="View Still life and flowers sketchbook page">
      {% optimizedImage "/images/sketchbook-still-life.jpg", "Colorful sketchbook study with flowers, foliage, containers, and water in green, orange, and violet washes.", "card", "lazy" %}
      <span>Still life and flowers</span>
    </a>
    <a href="/sketchbook/#street-study" aria-label="View Street study sketchbook page">
      {% optimizedImage "/images/sketchbook-street.jpg", "Watercolor and ink sketch of an urban street between buildings, with loose figures in the distance.", "card", "lazy" %}
      <span>Street study</span>
    </a>
    <a href="/sketchbook/#street-perspective" aria-label="View Street perspective sketchbook page">
      {% optimizedImage "/images/sketchbook-street-study.jpg", "Pencil sketchbook study looking down a city street, with buildings, pedestrians, and a figure in the foreground.", "card", "lazy" %}
      <span>Street perspective</span>
    </a>
  </div>
</section>
