---
layout: layouts/base.njk
title: "lucid vagary"
---
<div class="home-grid">

  {# LEFT: recent posts feed (skips the hero, which is the newest) #}
  <aside class="home-recent">
    {% for post in collections.posts.slice(1, 4) %}
    <a href="{{ post.url }}" class="recent-card">
      {% if post.data.image %}
      <div class="recent-image">
        <img src="{{ post.data.image }}" alt="{{ post.data.description or post.data.title }}" loading="lazy">
      </div>
      {% endif %}
      {% if post.data.tags %}
      <div class="post-tags-mini">
        {% for tag in post.data.tags %}
        <span class="post-tag-mini">{{ tag }}</span>
        {% endfor %}
      </div>
      {% endif %}
      <h4>{{ post.data.title }}</h4>
      <p class="post-date">{{ post.date | readableDate }}</p>
    </a>
    {% endfor %}
  </aside>

  {# CENTER: hero - the single newest post #}
  {% set hero = collections.posts | first %}
  <section class="home-hero">
    {% if hero.data.image %}
    <a href="{{ hero.url }}" class="hero-featured-image">
      <img src="{{ hero.data.image }}" alt="{{ hero.data.description or hero.data.title }}">
    </a>
    {% endif %}
    {% if hero.data.tags %}
    <div class="post-tags-mini">
      {% for tag in hero.data.tags %}
      <span class="post-tag-mini">{{ tag }}</span>
      {% endfor %}
    </div>
    {% endif %}
    <h2><a href="{{ hero.url }}">{{ hero.data.title }}</a></h2>
    {% if hero.data.description %}
    <p class="hero-featured-excerpt">{{ hero.data.description }}</p>
    {% endif %}
  </section>

  {# RIGHT: one highlight per tag #}
  <aside class="home-bytag">
    {% for item in collections.highlightsByTag %}
    <a href="{{ item.post.url }}" class="bytag-card">
      {% if item.post.data.image %}
      <div class="bytag-image">
        <img src="{{ item.post.data.image }}" alt="{{ item.post.data.description or item.post.data.title }}" loading="lazy">
      </div>
      {% endif %}
      <div class="bytag-body">
        <span class="post-tag-mini">{{ item.tag }}</span>
        <p class="bytag-excerpt">{{ item.post.data.description or item.post.data.title }}</p>
      </div>
    </a>
    {% endfor %}
  </aside>

</div>
