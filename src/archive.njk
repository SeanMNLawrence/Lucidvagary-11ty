---
layout: layouts/base.njk
title: "Artwork archive - lucid vagary"
description: "Browse the complete archive of artwork and writing by type, subject, and year."
permalink: /archive/
---
<div class="archive-columns">
  <div class="archive-column-heading" id="archive-current-heading">Current State</div>
  <div class="archive-column-heading" id="archive-future-heading">Future Outcome</div>
  <div class="archive-column archive-column-current" role="region" aria-labelledby="archive-current-heading">
<section class="posts-section archive-section" aria-labelledby="archive-title">
  <div class="archive-header">
    <div>
      <h1 class="posts-title" id="archive-title">archive</h1>
      <p class="archive-intro">Browse all artwork and writing, including older pages. Use the filters to explore by type, subject, or year.</p>
    </div>
    <p class="archive-count" aria-live="polite"><span id="archive-visible-count">{{ artworkArchive.count + collections.archiveLegacyEntries.length }}</span> of {{ artworkArchive.count + collections.archiveLegacyEntries.length }} entries</p>
  </div>

  <form class="archive-filters" id="archive-filters" aria-label="Filter the artwork archive">
    <label class="archive-filter" for="archive-type">
      <span>Type</span>
      <select name="type" id="archive-type">
        <option value="">All types</option>
        <option value="writing">Writing</option>
        <option value="artwork">Older artwork</option>
        {% for option in artworkArchive.filters.classifications %}
        <option value="{{ option.value }}">{{ option.label }} / artwork</option>
        {% endfor %}
      </select>
    </label>

    <label class="archive-filter" for="archive-year">
      <span>Year</span>
      <select name="year" id="archive-year">
        <option value="">All years</option>
        {% for year in collections.archiveYears %}
        <option value="{{ year }}">{{ year }}</option>
        {% endfor %}
      </select>
    </label>

    {% for facet in ["subject", "motif", "theme", "constellation"] %}
      {% set options = artworkArchive.filters[facet + "s"] %}
      {% if options.length %}
      <label class="archive-filter" for="archive-{{ facet }}">
        <span>{{ facet | capitalize }}</span>
        <select name="{{ facet }}" id="archive-{{ facet }}">
          <option value="">All {{ facet }}s</option>
          {% for option in options %}
          <option value="{{ option.value }}">{{ option.label }}</option>
          {% endfor %}
        </select>
      </label>
      {% endif %}
    {% endfor %}

    <label class="archive-filter" for="archive-tag">
      <span>Tag</span>
      <select name="tag" id="archive-tag">
        <option value="">All tags</option>
        {% for tag in collections.tagList %}
        <option value="{{ tag }}">{{ tag }}</option>
        {% endfor %}
      </select>
    </label>
  </form>

  <p class="archive-empty" id="archive-empty" hidden>No archive entries match these filters.</p>
  <div class="posts-list archive-list" id="archive-list" aria-label="Archive results">
    {% for artwork in collections.artworksWithArchiveDates %}
    <article
      class="post-card archive-card"
      data-origin="catalogue"
      data-type="{{ artwork.classification.type }}"
      data-year="{{ artwork.archiveDate | yearNumber }}"
      data-subjects="{{ artwork.subjects | join('|') }}"
      data-motifs="{{ artwork.motifs | artworkTermIds | join('|') }}"
      data-themes="{{ artwork.themes | join('|') }}"
      data-constellations="{{ artwork.constellations | join('|') }}"
      data-tags="artwork|{{ artwork.classification.type }}|{{ artwork.subjects | join('|') }}|{{ artwork.motifs | artworkTermIds | join('|') }}"
    >
      <a href="{{ artwork.url }}" aria-label="View artwork: {{ artwork.displayTitle }}">
        {% if artwork.primaryAsset.available %}
        <div class="listing-card-image">
          {% optimizedImage artwork.primaryAsset.path, artwork.primaryAsset.alt, "card", "lazy" %}
        </div>
        {% endif %}
        <div class="post-card-body">
          <div class="post-tags-mini">
            <span class="post-tag-mini">{{ artwork.classification.type | capitalize }}</span>
            {% for subject in artwork.subjects %}
            <span class="post-tag-mini">{{ subject | artworkTermLabel("subjects") }}</span>
            {% endfor %}
            {% for motif in artwork.motifs %}
            <span class="post-tag-mini">{{ motif.id | artworkTermLabel("motifs") }}</span>
            {% endfor %}
            {% for constellation in artwork.constellations %}
            <span class="post-tag-mini">{{ constellation | artworkTermLabel("constellations") }}</span>
            {% endfor %}
          </div>
          <h2>{{ artwork.displayTitle }}</h2>
          {% if artwork.archiveDate %}<p class="post-date">Year {{ artwork.archiveDate | yearNumber }}</p>{% endif %}
          {% if artwork.titleIsProposed %}<p class="artwork-title-status">Proposed title</p>{% endif %}
        </div>
      </a>
    </article>
    {% endfor %}
    {% for post in collections.archiveLegacyEntries %}
    <article class="post-card archive-card"
      data-origin="legacy"
      data-type="{{ post.archiveType }}"
      data-year="{{ post.date | yearNumber }}"
      data-subjects="{{ post.data.tags | join('|') }}"
      data-motifs=""
      data-themes=""
      data-constellations=""
      data-tags="{{ post.data.tags | join('|') }}">
      <a href="{{ post.url }}" aria-label="Read {{ post.data.title }}">
        {% if post.data.image %}
        <div class="listing-card-image">
          {% optimizedImage post.data.image, post.data.description or post.data.title, "card", "lazy" %}
        </div>
        {% endif %}
        <div class="post-card-body">
          <div class="post-tags-mini"><span class="post-tag-mini">{{ post.archiveType | capitalize }}</span></div>
          <h2>{{ post.data.title }}</h2>
          <p><time class="post-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time></p>
          {% if post.data.description %}<p class="post-excerpt">{{ post.data.description }}</p>{% endif %}
        </div>
      </a>
    </article>
    {% endfor %}
  </div>
</section>
  </div>
  <div class="archive-column archive-column-future" role="region" aria-labelledby="archive-future-heading"></div>
</div>

<script>
  (function () {
    var form = document.getElementById("archive-filters");
    var cards = Array.prototype.slice.call(document.querySelectorAll(".archive-card"));
    var count = document.getElementById("archive-visible-count");
    var empty = document.getElementById("archive-empty");
    var filterKeys = ["type", "year", "subject", "motif", "theme", "constellation", "tag"];
    var attributes = {
      subject: "subjects",
      motif: "motifs",
      theme: "themes",
      constellation: "constellations",
      tag: "tags"
    };

    var yearField = form.elements.year;
    var yearsInUse = cards.map(function (card) { return card.dataset.year; });
    Array.prototype.slice.call(yearField.options).forEach(function (option) {
      if (option.value && yearsInUse.indexOf(option.value) === -1) option.remove();
    });

    function syncInputsFromUrl() {
      var params = new URLSearchParams(window.location.search);
      filterKeys.forEach(function (key) {
        var field = form.elements[key];
        if (field) field.value = params.get(key) || "";
      });
    }

    function applyFilters() {
      var params = new URLSearchParams();
      var selected = {};
      filterKeys.forEach(function (key) {
        var field = form.elements[key];
        selected[key] = field ? field.value : "";
        if (selected[key]) params.set(key, selected[key]);
      });

      var visible = 0;
      cards.forEach(function (card) {
        var matches = filterKeys.every(function (key) {
          if (!selected[key]) return true;
          if (key === "type") return card.dataset.type === selected[key];
          if (key === "year") return card.dataset.year === selected[key];
          var values = (card.dataset[attributes[key]] || "").split("|").filter(Boolean);
          return values.indexOf(selected[key]) !== -1;
        });
        card.hidden = !matches;
        if (matches) visible += 1;
      });

      count.textContent = String(visible);
      empty.hidden = visible !== 0;
      var query = params.toString();
      window.history.replaceState({}, "", window.location.pathname + (query ? "?" + query : ""));
    }

    syncInputsFromUrl();
    form.addEventListener("change", applyFilters);
    window.addEventListener("popstate", function () {
      syncInputsFromUrl();
      applyFilters();
    });
    applyFilters();
  })();
</script>
