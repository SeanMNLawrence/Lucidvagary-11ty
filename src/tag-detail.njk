---
layout: layouts/base.njk
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: "/tags/{{ tag | slugify }}/"
eleventyComputed:
  title: "{{ tag }} - lucid vagary"
---
<section class="posts-section">
  <h1 class="posts-title">tag: {{ tag }}</h1>
  <div class="posts-list">
    {% for post in collections.posts %}
      {% if tag in post.data.tags %}
      <a href="{{ post.url }}" class="post-card" aria-label="Read {{ post.data.title }}">
        {% if post.data.image %}
        <div class="post-image">
          <img src="{{ post.data.image }}" alt="" aria-hidden="true" loading="lazy">
        </div>
        {% endif %}
        <div class="post-card-body">
          <h3>{{ post.data.title }}</h3>
          <p><time class="post-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time></p>
        </div>
      </a>
      {% endif %}
    {% endfor %}
  </div>
</section>
