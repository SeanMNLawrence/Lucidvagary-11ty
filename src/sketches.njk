---
layout: layouts/base.njk
title: "sketches - lucid vagary"
permalink: /sketches/
---
<section class="posts-section">
  <h1 class="posts-title">sketches</h1>
  {% set archive = collections.archiveCounts | first %}
  {% if archive %}
  <p class="post-excerpt">{{ archive.artworks }} artworks · {{ archive.assets }} digital assets</p>
  {% endif %}
  <div class="posts-list">
    {% for sketch in collections.artworks %}
    <a href="{{ sketch.url }}" class="post-card" aria-label="Read {{ sketch.data.title }}">
      {% if sketch.data.image %}
      <div class="listing-card-image">
        <img src="{{ sketch.data.image }}" alt="" aria-hidden="true" loading="lazy">
      </div>
      {% endif %}
      <div class="post-card-body">
        <h3>{{ sketch.data.title }}</h3>
        <p><time class="post-date" datetime="{{ sketch.date | htmlDateString }}">{{ sketch.date | readableDate }}</time></p>
        {% if sketch.data.description %}
        <p class="post-excerpt">{{ sketch.data.description }}</p>
        {% endif %}
      </div>
    </a>
    {% endfor %}
  </div>
</section>
