---
layout: layouts/base.njk
title: "constellations - lucid vagary"
permalink: /constellations/
---
<section class="posts-section">
  <h1 class="posts-title">constellations</h1>
  <div class="posts-list">
    {% for constellation in constellations %}
    <a href="/constellations/{{ constellation.slug }}/" class="post-card">
      <div class="post-card-body">
        <h3>{{ constellation.title }}</h3>
        <p class="post-excerpt">{{ constellation.introduction }}</p>
      </div>
    </a>
    {% endfor %}
  </div>
</section>
