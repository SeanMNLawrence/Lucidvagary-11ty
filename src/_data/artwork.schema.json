{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lucidvagary.com/schema/artwork.schema.json",
  "title": "Artwork",
  "description": "Canonical model for an artwork and its one-or-more digital assets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artwork_id",
    "title",
    "slug",
    "original_title",
    "proposed_title",
    "classification",
    "curatorial_status",
    "subjects",
    "motifs",
    "themes",
    "constellations",
    "relationships",
    "assets",
    "provenance"
  ],
  "properties": {
    "artwork_id": {
      "$ref": "#/$defs/artworkId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "$ref": "#/$defs/slugId"
    },
    "original_title": {
      "type": ["string", "null"]
    },
    "proposed_title": {
      "type": ["string", "null"]
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "confidence"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["drawing", "sketch", "undecided"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "curatorial_status": {
      "type": "string",
      "enum": ["curatorial-review", "published"]
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "motifs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/scoredTaxonomyTerm"
      }
    },
    "themes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/taxonomyId"
      }
    },
    "constellations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/taxonomyId"
      }
    },
    "relationships": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artworkRelationship"
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/digitalAsset"
      },
      "contains": {
        "type": "object",
        "properties": {
          "role": {
            "const": "primary"
          }
        },
        "required": ["role"]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artwork_creation_date", "source_records"],
      "properties": {
        "artwork_creation_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ],
          "description": "Creation date of the artwork itself (if known)."
        },
        "notes": {
          "type": "string"
        },
        "source_records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "artworkRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target_slug"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "shares-motif-with",
            "related-to",
            "variant-of",
            "study-for",
            "developed-into",
            "alternate-asset-of",
            "belongs-to-series"
          ]
        },
        "target_slug": {
          "$ref": "#/$defs/slugId"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "Required for study-for and developed-into relationships; record the evidence rather than relying on visual similarity."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["study-for", "developed-into"]
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["evidence"]
          }
        }
      ]
    },
    "slugId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "artworkId": {
      "type": "string",
      "pattern": "^lv-artwork-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "taxonomyId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "scoredTaxonomyTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "confidence"],
      "properties": {
        "id": {
          "$ref": "#/$defs/taxonomyId"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "digitalAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "original_filename"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["primary", "alternate"]
        },
        "path": {
          "type": ["string", "null"]
        },
        "availability": {
          "type": "string",
          "enum": ["source-unavailable"]
        },
        "original_filename": {
          "type": "string",
          "minLength": 1
        },
        "asset_capture_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ],
          "description": "Date this digital asset was captured; may differ from artwork_creation_date."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "alt": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "source-unavailable"
              }
            },
            "required": ["availability"]
          },
          "then": {
            "properties": {
              "path": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "primary"
              }
            },
            "required": ["role"]
          },
          "then": {
            "required": ["alt"]
          }
        }
      ]
    }
  }
}
