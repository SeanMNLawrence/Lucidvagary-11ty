{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lucidvagary.com/schema/artwork.schema.json",
  "title": "Artwork",
  "description": "Canonical model for an artwork and its one-or-more digital assets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "slug",
    "original_title",
    "proposed_title",
    "classification",
    "curatorial_status",
    "subjects",
    "motifs",
    "themes",
    "constellations",
    "relationships",
    "assets",
    "provenance"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "original_title": {
      "type": ["string", "null"]
    },
    "proposed_title": {
      "type": ["string", "null"]
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "confidence"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["drawing", "sketch", "undecided"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "curatorial_status": {
      "type": "string",
      "minLength": 1
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "motifs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "themes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constellations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relationships": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artworkRelationship"
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/digitalAsset"
      },
      "contains": {
        "type": "object",
        "properties": {
          "role": {
            "const": "primary"
          }
        },
        "required": ["role"]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artwork_creation_date", "source_records"],
      "properties": {
        "artwork_creation_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ],
          "description": "Creation date of the artwork itself (if known)."
        },
        "notes": {
          "type": "string"
        },
        "source_records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "artworkRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target_slug"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "variant_of",
            "study_for",
            "part_of_series",
            "inspired_by",
            "related_to"
          ]
        },
        "target_slug": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "digitalAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "original_filename"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["primary", "alternate"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "original_filename": {
          "type": "string",
          "minLength": 1
        },
        "asset_capture_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ],
          "description": "Date this digital asset was captured; may differ from artwork_creation_date."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
