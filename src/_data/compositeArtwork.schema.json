{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lucidvagary.com/schema/composite-artwork.schema.json",
  "title": "Composite artwork",
  "type": "object",
  "additionalProperties": false,
  "required": ["artwork_id", "title", "url", "components"],
  "properties": {
    "artwork_id": {
      "type": "string",
      "pattern": "^lv-composite-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "pattern": "^/posts/[a-zA-Z0-9-]+/$"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artwork_id", "order"],
        "properties": {
          "artwork_id": {
            "type": "string",
            "pattern": "^lv-artwork-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "order": {
            "type": ["integer", "null"],
            "minimum": 1
          }
        }
      }
    }
  }
}
