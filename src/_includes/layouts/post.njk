---
layout: layouts/base.njk
---
<div class="post-with-sidebar">
  <article class="post-single">
    <header class="post-header">
      <h1>{{ title }}</h1>
      <p><time class="post-date" datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time></p>
      {% if tags %}
      <nav class="post-tags" aria-label="Tags for {{ title }}">
        {% for tag in tags %}
          {% if tag != "poem" and tag != "fragment" and tag != "artwork" %}
            <a href="/tags/{{ tag | slugify }}/" class="post-tag" rel="tag">More {{ tag }} posts</a>
          {% endif %}
        {% endfor %}
      </nav>
      {% endif %}
    </header>

    {% set assets = digitalAssets or [] %}
    {% if not assets.length and image %}
      {% set assets = [{ src: image, alt: image | artworkAltForImage(description or title), primary: true }] %}
    {% endif %}
    {% set primary = primaryAsset or (assets | first) %}
    {% set primaryIndex = primaryAssetIndex if primaryAssetIndex != null and primaryAssetIndex >= 0 else null %}
    {% if primary and primaryIndex == null %}
      {% set primaryIndex = 0 %}
    {% endif %}
    {% if primary and not suppressPrimaryImage %}
    <figure class="post-image">
      {% optimizedImage primary.src, primary.alt or description or (title + " artwork"), "artwork", "eager" %}
      {% if imageCaption %}<figcaption>{{ imageCaption }}</figcaption>{% endif %}
    </figure>
    {% endif %}

    {% if assets.length > 1 %}
    <section class="post-alternate-assets">
      <h2>Alternate photographs</h2>
      <ul>
        {% for asset in assets %}
          {% if primaryIndex == null or loop.index0 != primaryIndex %}
          <li>
            <a href="{{ asset.src }}">{{ asset.alt or title }}</a>
          </li>
          {% endif %}
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    <div class="post-content">
      {{ content | safe }}
    </div>
  </article>

  <aside class="post-sidebar" aria-labelledby="related-posts-heading">
    <h2 class="sidebar-title" id="related-posts-heading">more from lucid vagary</h2>
    {% set related = collections.posts | relatedPosts(page.url, tags, 4) %}
    {% for post in related %}
    <a href="{{ post.url }}" class="sidebar-card">
      {% if post.data.image %}
      <div class="sidebar-card-image">
        {% optimizedImage post.data.image, "", "thumbnail", "lazy" %}
      </div>
      {% endif %}
      <div class="sidebar-card-body">
        <h3>{{ post.data.title }}</h3>
        <p><time class="post-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time></p>
      </div>
    </a>
    {% endfor %}
  </aside>
</div>
