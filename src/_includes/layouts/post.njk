---
layout: layouts/base.njk
---
<div class="post-with-sidebar">
  <article class="post-single">
    <header class="post-header">
      <h1>{{ title }}</h1>
      <p><time class="post-date" datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time></p>
      {% if tags %}
      <nav class="post-tags" aria-label="Tags for {{ title }}">
        {% for tag in tags %}
          {% if tag != "poem" and tag != "fragment" and tag != "artwork" %}
            <a href="/tags/{{ tag | slugify }}/" class="post-tag" rel="tag" aria-label="View more posts tagged {{ tag }}">{{ tag }}</a>
          {% endif %}
        {% endfor %}
      </nav>
      {% endif %}
    </header>

    {% set assets = digitalAssets or [] %}
    {% set primary = primaryAsset or (assets | first) %}
    {% set primaryIndex = primaryAssetIndex if primaryAssetIndex != null and primaryAssetIndex >= 0 else null %}
    {% if primary and primaryIndex == null %}
      {% set primaryIndex = 0 %}
    {% endif %}
    {% if primary or image %}
    <figure class="post-image">
      {% if primary %}
      <img src="{{ primary.src }}" alt="{{ primary.alt or imageAlt or description or title }}">
      {% else %}
      <img src="{{ image }}" alt="{{ imageAlt or description or title }}">
      {% endif %}
      {% if imageCaption %}
      <figcaption>{{ imageCaption }}</figcaption>
      {% endif %}
    </figure>
    {% endif %}

    {% if assets.length > 1 %}
    <section class="post-alternate-assets">
      <h3>alternate photographs</h3>
      <ul>
        {% for asset in assets %}
          {% if primaryIndex == null or loop.index0 != primaryIndex %}
          <li>
            <a href="{{ asset.src }}">{{ asset.alt or title }}</a>
          </li>
          {% endif %}
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    <div class="post-content">
      {{ content | safe }}
    </div>
  </article>

  <aside class="post-sidebar" aria-label="Related artworks and posts">
    {% set isArtwork = tags and "artwork" in tags %}
    {% if isArtwork %}
      {% set relatedArtworkGroups = collections.artworks | relatedArtworks(page.url, artworkRelationships, motifs, themes, 4, 4) %}
      {% if relatedArtworkGroups.explicit.length or relatedArtworkGroups.semantic.length %}
        <h2 class="sidebar-title">related artworks</h2>

        {% if relatedArtworkGroups.explicit.length %}
        <div class="sidebar-section">
          <h3 class="sidebar-section-title">explicit relationships</h3>
          {% for relation in relatedArtworkGroups.explicit %}
          <a href="{{ relation.post.url }}" class="sidebar-card">
            {% if relation.post.data.image %}
            <div class="sidebar-card-image">
              <img src="{{ relation.post.data.image }}" alt="" aria-hidden="true" loading="lazy">
            </div>
            {% endif %}
            <div class="sidebar-card-body">
              <p class="sidebar-relation-label">{{ relation.relationshipType }}</p>
              <h4>{{ relation.post.data.title }}</h4>
              <p><time class="post-date" datetime="{{ relation.post.date | htmlDateString }}">{{ relation.post.date | readableDate }}</time></p>
            </div>
          </a>
          {% endfor %}
        </div>
        {% endif %}

        {% if relatedArtworkGroups.semantic.length %}
        <div class="sidebar-section">
          <h3 class="sidebar-section-title">shared motifs &amp; themes</h3>
          {% for relation in relatedArtworkGroups.semantic %}
          <a href="{{ relation.post.url }}" class="sidebar-card">
            {% if relation.post.data.image %}
            <div class="sidebar-card-image">
              <img src="{{ relation.post.data.image }}" alt="" aria-hidden="true" loading="lazy">
            </div>
            {% endif %}
            <div class="sidebar-card-body">
              <p class="sidebar-relation-label">semantic similarity</p>
              <h4>{{ relation.post.data.title }}</h4>
              {% if relation.sharedMotifs.length %}
              <p class="sidebar-relation-meta">motifs: {{ relation.sharedMotifs | join(", ") }}</p>
              {% endif %}
              {% if relation.sharedThemes.length %}
              <p class="sidebar-relation-meta">themes: {{ relation.sharedThemes | join(", ") }}</p>
              {% endif %}
            </div>
          </a>
          {% endfor %}
        </div>
        {% endif %}
      {% else %}
        <h2 class="sidebar-title">more from lucid vagary</h2>
        {% set related = collections.posts | relatedPosts(page.url, tags, 4) %}
        {% for post in related %}
        <a href="{{ post.url }}" class="sidebar-card">
          {% if post.data.image %}
          <div class="sidebar-card-image">
            <img src="{{ post.data.image }}" alt="" aria-hidden="true" loading="lazy">
          </div>
          {% endif %}
          <div class="sidebar-card-body">
            <h4>{{ post.data.title }}</h4>
            <p><time class="post-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time></p>
          </div>
        </a>
        {% endfor %}
      {% endif %}
    {% else %}
      <h2 class="sidebar-title">more from lucid vagary</h2>
      {% set related = collections.posts | relatedPosts(page.url, tags, 4) %}
      {% for post in related %}
      <a href="{{ post.url }}" class="sidebar-card">
        {% if post.data.image %}
        <div class="sidebar-card-image">
          <img src="{{ post.data.image }}" alt="" aria-hidden="true" loading="lazy">
        </div>
        {% endif %}
        <div class="sidebar-card-body">
          <h4>{{ post.data.title }}</h4>
          <p><time class="post-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time></p>
        </div>
      </a>
      {% endfor %}
    {% endif %}
  </aside>
</div>
